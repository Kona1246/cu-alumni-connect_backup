# Copy this file to ".env" and change what you need. Every setting is optional.

# Port the website runs on (open http://localhost:3000)
PORT=3000

# Where data is stored when DATABASE_URL is empty. Relative paths are inside this folder.
# Copy this folder to another computer (or a USB drive / OneDrive / Google Drive folder)
# and everything – members, passwords, chat, notices, attachments, backups – moves with it.
DATA_DIR=data

# Optional: use one shared PostgreSQL database instead (needed for cloud hosting such as
# Render/Railway, or when several servers must share data). Free options: Neon, Supabase.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Password for the "cu-admin" staff account, applied only when the database is first created.
# If you leave it empty the demo password cu-admin-1857 is used – change it after signing in.
ADMIN_PASSWORD=

# true  = start with the demo members, chat and feedback (as in the original file)
# false = start with only the directories, student records, sample notices and one admin account
SEED_DEMO_DATA=true

# Automatic backups (folder: data/backups unless BACKUP_DIR is set). 0 turns them off.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# BACKUP_DIR=D:\CU-Backups

# How long people stay signed in, in days
SESSION_DAYS=30

# Largest notice attachment, in MB
MAX_UPLOAD_MB=10

# Optional fixed secret for sign-in cookies. Normally leave empty: one is generated and
# stored with the data, so it moves with the data folder / database.
# SESSION_SECRET=

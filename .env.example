# Copy this file to ".env" and edit it to change settings. All are optional.

# Port on your computer where the site will be available (http://localhost:8080)
HOST_PORT=8080

# true  = first start loads sample alumni, members, notices, chat and feedback (good for trying it out)
# false = first start loads only campuses, departments, faculty, officials and the cu-admin account
SEED_DEMO_DATA=true

# Show the sample sign-in details in a bar at the top of the page. Set to false for real use.
SHOW_DEMO_LOGINS=true

# Password for the "cu-admin" staff account, applied when the database is first created.
# Leave empty to keep the demo password (cu-admin-1857).
ADMIN_PASSWORD=

# Set both to true when the site is served over HTTPS behind a reverse proxy (nginx, Caddy, Traefik...).
COOKIE_SECURE=false
TRUST_PROXY=false

# Largest notice attachment staff can upload, in MB.
MAX_UPLOAD_MB=10
